@startuml
skinparam backgroundColor transparent
skinparam defaultTextColor #333333

skinparam actor {
  BorderColor #2C3E50
  FontColor #2C3E50
  FontSize 12
  FontStyle bold
}

skinparam participant {
  BorderColor #3F51B5
  FontColor #ffffff
  FontSize 11
  FontStyle bold
}

skinparam database {
  BorderColor #5D4037
  BackgroundColor #EFEBE9
  FontColor #5D4037
  FontSize 11
  FontStyle bold
}

skinparam sequence {
  ArrowColor #555555
  ArrowFontColor #555555
  ArrowFontSize 10
  LifeLineBorderColor #999999
  LifeLineBackgroundColor #dddddd
}

actor Apprenant as A
participant "Interface\n(Flask)" as UI #3F51B5
participant "ProfilApprenant" as PA #009688
participant "Pipeline" as PL #1565C0
participant "FormeEvaluator" as FE #43A047
participant "Similarite\nCalculator" as SC #7CB342
participant "FondEvaluator" as FD #E65100
participant "API Mistral\n(LLM + Embed)" as M #D32F2F
participant "MachineEtats" as ME #6A1B9A
database "Disque\n(JSON / fichiers)" as FS #5D4037

A -> UI : POST /evaluer\n(texte, contraction, quota, mode)
activate UI

UI -> PA : get_profil()
activate PA
PA --> UI : profil (ou nouveau)
deactivate PA

UI -> PL : evaluer_avec_pipeline\n(source, contraction, quota, profil, est_test)
activate PL

PL -> FE : evaluer_forme(source, contraction, quota)
activate FE

FE -> SC : lcs(source, contraction)
activate SC
SC --> FE : score_lcs
SC --> FE : score_plagiat
SC --> FE : label
deactivate SC

FE -> SC : jaccard_bigrams, cosine_tfidf
activate SC
SC --> FE : scores
deactivate SC

FE -> FE : evaluer_syntaxe()
FE -> FE : evaluer_orthographe()
FE --> PL : dict score_forme (/7)
deactivate FE

PL -> FD : evaluer_fond(source, contraction)
activate FD

FD -> M : mistral-embed(source)
activate M
M --> FD : vecteur source
deactivate M

FD -> M : mistral-embed(contraction)
activate M
M --> FD : vecteur contraction
deactivate M

FD -> FD : cosine_similarity(vecteurs)\n→ score_semantique

FD -> M : few-shot prompt CoT\n(source, contraction, exemples)
activate M
M --> FD : score_fond_brut (0-3)\ncontresens, subjectivite\nfeedback, raisonnement
deactivate M

FD -> FD : calibrer(score_semantique,\nscore_llm)
FD --> PL : dict score_fond (/3)
deactivate FD

PL -> PL : appliquer_verrous()
PL -> PL : calculer note_finale (/10 → /20)

PL -> ME : enregistrer_exercice(score)\nou evaluer_cycle(score)
activate ME
ME --> PL : palier mis à jour + décision
deactivate ME

PL --> UI : dict resultat complet
deactivate PL

UI -> FS : sauvegarder_production(session_id,\njson)
UI -> FS : ecrire_historique(json)
UI -> A : redirect /resultats/<session_id>

A -> UI : GET /resultats/<session_id>
activate UI
UI -> FS : lire_historique() + resultat.json
FS --> UI : données
UI -> A : template resultats.html\n(scores, feedback, palier)
deactivate UI

@enduml
