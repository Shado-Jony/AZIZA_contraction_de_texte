# AZIZA v2.0 — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# Clé API Mistral (obligatoire pour l'évaluation du Fond /3)
# Obtenir une clé sur https://console.mistral.ai/
MISTRAL_API_KEY=votre_cle_api_mistral

# Secret Flask (changez-le en production)
FLASK_SECRET_KEY=aziza-dev-key-change-in-production

# Mode Flask (development / production)
FLASK_ENV=development

# Port du serveur (défaut 5100)
FLASK_PORT=5100
